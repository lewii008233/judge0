monitor_urls = [
    "https://smarttrader.deriv.com/",  # Tab 1 (also purchase tab) - REPLACE
    "https://www.deriv.com/",          # Tab 2 - REPLACE
    "https://www.deriv.com/digits-pro/home/",  # Tab 3 - REPLACE
    "https://www.deriv.com/digits-pro/"        # Tab 4 - REPLACE
]

# Conditions for each tab (strictly following your rules)
conditions = {
    monitor_urls[0]: {  # Tab 1: Bars for 7, 8, 9 must not be above 12%
        "type": "bars_below_12",
        "digits": [7, 8, 9],
        "threshold": 12.0
    },
    monitor_urls[1]: {  # Tab 2: No colored semi-circle on 7, 8, or 9
        "type": "no_semi_circle",
        "forbidden_digits": [7, 8, 9]
    },
    monitor_urls[2]: {  # Tab 3: Pink circle must be on 7, 8, or 9
        "type": "pink_circle",
        "allowed_digits": [7, 8, 9]
    },
    monitor_urls[3]: {  # Tab 4: "Under" % increases from 86.00%-86.99% to >86.99%
        "type": "percentage_change",
